module KeycloakClient
  self.@config: untyped

  self.@root: untyped

  attr_writer self.config: untyped

  def self.config: () -> untyped

  def self.configure: () { (untyped) -> untyped } -> untyped

  def self.root: () -> untyped
end

module KeycloakClient
  class AdminClient
    @realm: untyped

    @realm_stack: untyped

    @username: untyped

    @password: untyped

    @conn: untyped

    @token: untyped

    @token_expires_at: untyped

    include Resources::Users

    include Resources::Realms

    include Resources::Clients

    include Resources::Organizations

    include Resources::Roles

    include Resources::Groups

    include Resources::ClientScopes

    def initialize: (?realm: untyped?, ?username: untyped?, ?password: untyped?) -> void

    def authorize!: () -> untyped

    def for_realm: (untyped realm) { () -> untyped } -> untyped

    def authorize_if_needed: () -> (untyped | nil)

    def get: (untyped path, ?::Hash[untyped, untyped] params, ?::Hash[untyped, untyped] headers, ?admin_scoped: bool) -> untyped

    def put: (untyped path, ?::Hash[untyped, untyped] body, ?::Hash[untyped, untyped] headers, ?admin_scoped: bool) -> untyped

    def post: (untyped path, ?::Hash[untyped, untyped] body, ?::Hash[untyped, untyped] headers, ?admin_scoped: bool) -> untyped

    def delete: (untyped path, ?::Hash[untyped, untyped] params, ?::Hash[untyped, untyped] headers, ?admin_scoped: bool) -> untyped

    def form_post: (untyped path, ?::Hash[untyped, untyped] body, ?::Hash[untyped, untyped] headers, ?admin_scoped: bool) -> untyped

    def current_realm: () -> untyped

    private

    attr_reader token: untyped

    attr_reader token_expires_at: untyped

    attr_reader username: untyped

    attr_reader password: untyped
  end
end

